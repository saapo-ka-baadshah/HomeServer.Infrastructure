proxmox_endpoint  = "https://192.168.1.10:8006/"
proxmox_api_token = "terraform@pve!tf=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure  = true

# SSH access to the node is required to upload cloud-init snippets.
# Recommended: load your key into ssh-agent (proxmox_ssh_agent = true).
# Alternatively set proxmox_ssh_private_key to the key contents, e.g. file("~/.ssh/id_ed25519")
proxmox_ssh_agent    = true
proxmox_ssh_username = "root"

default_node = "pve"

# Dedicated Kubernetes bridge and management subnet (see HS-ANS-003).
# kube_bridge_name defaults to "vmbr1"; set here to override.
# kube_mgmt_subnet defaults to "10.200.0.0/24"; must not overlap with
# host (192.168.178.0/24), pod (10.168.178.0/24), or service (10.96.0.0/12) CIDRs.
# The Proxmox host owns the first usable IP of the subnet (10.200.0.1) on the
# bridge and acts as the INTERNAL gateway for the K8s nodes: set per-VM `gateway`
# to that host IP so all cluster communication stays on 10.200.0.0/24.
# `gateway` = null only if the bridge is truly isolated (no default route).
# second_bridge / second_ip_address: optional secondary NIC (home LAN) used only
# for internet egress; nodes NAT through the host, the router is NOT the gateway.
# Each VM gets a second NIC on vmbr0 (home LAN) for apt/image pulls.

kube_vms = {
  kube-ctrl = {
    name           = "kube-ctrl"
    description    = "Kubernetes control plane managed by Terraform"
    resource_count = 1
    template_vm_id = 900           # your cloud-init template ID
    vm_id          = 1001
    cores          = 3
    memory         = 5192
    disk_size      = 32
    bridge             = "vmbr1"       # dedicated K8s bridge
    ip_address         = "10.200.0.200/24"
    gateway            = "10.200.0.1"   # internal gateway on the Proxmox host (vmbr1)
    second_bridge      = "vmbr0"       # secondary NIC for internet via home LAN
    second_ip_address  = "dhcp"
    username           = "ubuntu"
    tags               = ["k8s", "terraform"]
    hostname           = "machine"
  }

  kube-worker-0 = {
    name               = "kube-worker-0"
    description        = "Kubernetes worker node 0 managed by Terraform"
    resource_count     = 1
    template_vm_id     = 900
    vm_id              = 1002
    cores              = 3
    memory             = 5192
    disk_size          = 32
    bridge             = "vmbr1"
    ip_address         = "10.200.0.201/24"
    gateway            = "10.200.0.1"
    second_bridge      = "vmbr0"
    second_ip_address  = "dhcp"
    username           = "ubuntu"
    tags               = ["k8s", "terraform"]
    hostname           = "machine"
  }
}
